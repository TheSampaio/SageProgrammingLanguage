use http_client;
use text;
use console;

func main(): none
{
    var url: Text = text::from("http://127.0.0.1:@PORT@/from-sage?q=a&b=%22c%22");
    var body: Text = text::create(1024);
    var result: HttpResult = http_client::get(&url, &mut body);
    var out1: Text = $"ok={result.ok} exit={result.exit_code} truncated={result.truncated}";
    out1.print_line();
    body.print_line();
}
