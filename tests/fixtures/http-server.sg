use http_server;
use text;
use console;

// Serves two requests on 127.0.0.1:@PORT@, echoing each request head.
func main(): none
{
    var server: HttpListener = http_server::listen_local(@PORT@);
    var clash: HttpListener = http_server::listen_local(@PORT@);
    var listening: b8 = server.is_listening();
    var port_matches: b8 = server.port() == @PORT@;
    var clashed: b8 = clash.is_listening();
    var out1: Text = $"listening={listening} port_matches={port_matches} clash={clashed}";
    out1.print_line();
    if (true)
    {
        var scoped: HttpListener = http_server::listen_local(0);
        var ephemeral: b8 = scoped.is_listening() && scoped.port() != 0;
        var out2: Text = $"ephemeral={ephemeral}";
        out2.print_line();
    }
    var request: Text = text::create(64);
    var body: Text = text::create(256);
    var served: i32 = 0;
    var attempts: i32 = 0;
    while (served < 2 && attempts < 10)
    {
        attempts = attempts + 1;
        if (server.accept(&mut request))
        {
            body.clear();
            body.append_str("you sent: ");
            body.append(&request);
            if (server.respond(200, &body)) { served = served + 1; }
        }
    }
    var invalid: b8 = server.respond(200, &body);
    var out3: Text = $"served={served} respond_without_client={invalid}";
    out3.print_line();
    http_server::close(server);
}
