extern trace("@TRACKER_HEADER@")
{
    type ResourceHandle;
    func resource_open(id: c_int): ResourceHandle*;
    func resource_close(handle: ResourceHandle*): c_int;
    func resource_outstanding(): c_int;
    func resource_release_order(): c_int;
    func resource_drop_calls(): c_int;
    func resource_reset(): none;
    func resource_check(condition: b8, name: str): none;
    resource OwnedHandle: ResourceHandle* drop resource_close;
}

struct Pair
{
    first: OwnedHandle;
    second: OwnedHandle;
    value: i32;
}

func produce(id: i32): OwnedHandle
{
    unsafe
    {
        var owner: OwnedHandle = trace::resource_open(id as c_int) as OwnedHandle;
        return owner;
    }
}

func early(): i32
{
    var owner: OwnedHandle = produce(4);
    var pair: Pair = { first = owner, value = 7 };
    return pair.value;
}

unsafe func main(): none
{
    trace::resource_reset();
    if (true)
    {
        var first: OwnedHandle = produce(1);
        var second: OwnedHandle = produce(2);
        var pair: Pair = { first = first, second = second, value = 9 };
        trace::resource_check(pair.value == 9, "copyable_field_access");
        trace::resource_check(trace::resource_outstanding() == 2, "both_fields_live");
    }
    trace::resource_check(trace::resource_outstanding() == 0, "all_fields_cleaned");
    trace::resource_check(trace::resource_release_order() == 21, "reverse_field_cleanup");
    trace::resource_check(trace::resource_drop_calls() == 2, "fields_dropped_once");

    trace::resource_reset();
    var result: i32 = early();
    trace::resource_check(result == 7, "early_return_value");
    trace::resource_check(trace::resource_outstanding() == 0, "early_return_cleanup");
    trace::resource_check(trace::resource_release_order() == 4 && trace::resource_drop_calls() == 1,
        "partial_struct_drops_initialized_field_once");

    trace::resource_reset();
    if (true)
    {
        var empty: Pair = {};
        trace::resource_check(empty.value == 0, "empty_struct_zero_initialized");
    }
    trace::resource_check(trace::resource_drop_calls() == 0, "empty_struct_skips_destructors");

    trace::resource_reset();
    if (true)
    {
        var first: OwnedHandle = produce(1);
        var pair: Pair = { first = first };
        var replacement: OwnedHandle = produce(2);
        pair.first = replacement;
        trace::resource_check(trace::resource_outstanding() == 1, "old_field_released_on_replacement");
        trace::resource_check(trace::resource_release_order() == 1, "old_field_released_first");
        trace::resource_check(trace::resource_drop_calls() == 1, "old_field_released_once");
    }
    trace::resource_check(trace::resource_outstanding() == 0, "replacement_released_at_scope_exit");
    trace::resource_check(trace::resource_release_order() == 12, "field_replacement_cleanup_order");
    trace::resource_check(trace::resource_drop_calls() == 2, "field_replacement_total_drops");

    trace::resource_reset();
    if (true)
    {
        var pair: Pair = {};
        var replacement: OwnedHandle = produce(3);
        pair.first = replacement;
        trace::resource_check(trace::resource_drop_calls() == 0, "empty_field_replacement_skips_drop");
    }
    trace::resource_check(trace::resource_release_order() == 3, "empty_field_replacement_cleanup");
    trace::resource_check(trace::resource_drop_calls() == 1, "empty_field_replacement_drops_once");
}
