extern trace("@TRACKER_HEADER@")
{
    type ResourceHandle;
    func resource_open(id: c_int): ResourceHandle*;
    func resource_null(): ResourceHandle*;
    func resource_close(handle: ResourceHandle*): c_int;
    func resource_read(handle: ResourceHandle*): c_int;
    func resource_outstanding(): c_int;
    func resource_release_order(): c_int;
    func resource_drop_calls(): c_int;
    func resource_reset(): none;
    func resource_check(condition: b8, name: str): none;
    resource OwnedHandle: ResourceHandle* drop resource_close;
}

func produce(id: i32): OwnedHandle
{
    unsafe
    {
        var owner: OwnedHandle = trace::resource_open(id as c_int) as OwnedHandle;
        return owner;
    }
}

unsafe func main(): none
{
    trace::resource_reset();
    if (true)
    {
        var first: OwnedHandle = produce(1);
        var second: OwnedHandle = produce(2);
        first = second;
        trace::resource_check(trace::resource_outstanding() == 1, "old_destination_destroyed");
        trace::resource_check(trace::resource_drop_calls() == 1, "destination_destroyed_once");
        trace::resource_check(trace::resource_release_order() == 1, "old_destination_destroyed_first");
        trace::resource_check(trace::resource_read(first as ResourceHandle*) == 2, "replacement_is_live");
    }
    trace::resource_check(trace::resource_outstanding() == 0, "replacement_scope_cleanup");
    trace::resource_check(trace::resource_release_order() == 12, "replacement_cleanup_order");
    trace::resource_check(trace::resource_drop_calls() == 2, "both_resources_destroyed_once");

    trace::resource_reset();
    if (true)
    {
        var empty: OwnedHandle = trace::resource_null() as OwnedHandle;
        var live: OwnedHandle = produce(3);
        empty = live;
        trace::resource_check(trace::resource_drop_calls() == 0, "empty_destination_skips_destructor");
    }
    trace::resource_check(trace::resource_release_order() == 3 && trace::resource_drop_calls() == 1,
        "replacement_of_empty_owner_destroyed_once");
}
