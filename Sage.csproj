<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	
	<!-- Development instrumentation: `dotnet build -c Instrumented` (or -p:SageInstrumentation=true)
	     defines SAGE_INSTRUMENTATION, which prints phase timings, cache counts and memory to stderr. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Instrumented'">
		<Optimize>true</Optimize>
		<SageInstrumentation>true</SageInstrumentation>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SageInstrumentation)' == 'true'">
		<DefineConstants>$(DefineConstants);SAGE_INSTRUMENTATION</DefineConstants>
	</PropertyGroup>
	
	<ItemGroup>
	  <Folder Include="Assets\Images\" />
	  <Content Include="Runtime\include\**\*.h" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	  <!-- The distributed std: projects without a local 'std' folder resolve it beside the compiler. -->
	  <Content Include="Sandbox\std\*.sg" Link="std\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
