/// Standard Library: Memory
/// Low-level, explicit heap primitives backed by the C standard library.
///
/// These wrappers traffic in raw pointers (none*), so they are declared `unsafe func`
/// and must be called from within an `unsafe` block. For everyday allocation prefer the
/// memory-safe `new` / `delete` keywords instead.
module memory
{
    // --- Native C Bindings (Private to this module) ---

    /// Bindings to the C standard library memory management functions.
    extern libc_stdlib("stdlib.h")
    {
        /// Allocates a block of memory of the given size (in bytes).
        func malloc(size: u64): none*;

        /// Frees a previously allocated block of memory.
        func free(ptr: none*): none;
    }

    // --- High-Level API ---

    /// Allocates a raw block of heap memory of the specified size (in bytes).
    unsafe func alloc(size: u64): none*
    {
        return libc_stdlib::malloc(size);
    }

    /// Releases a previously allocated raw block of heap memory.
    /// Passing an invalid or already freed pointer results in undefined behavior.
    unsafe func release(ptr: none*): none
    {
        libc_stdlib::free(ptr);
    }
}
