/// Standard Library: Test
/// A minimal unit-testing framework for Sage.
///
/// Each assertion prints a machine-readable line:
///   [PASS] <name>
///   [FAIL] <name> (details)
///
/// Tooling (e.g. the VS Code Test Explorer) discovers `.sg` files under a `tests/`
/// folder, runs them, and parses these lines into individual test results.
use text;

module test
{
    extern libc_string("string.h")
    {
        func strcmp(a: c_char*, b: c_char*): c_int;
    }

    /// Reports a boolean result under the given test name.
    func report(name: str, passed: b8): none
    {
        if (passed)
        {
            var line: Text = $"[PASS] {name}";
            line.print_line();
        }
        else
        {
            var line: Text = $"[FAIL] {name}";
            line.print_line();
        }
    }

    /// Asserts that a condition is true.
    func assert_true(name: str, condition: b8): none
    {
        test::report(name, condition);
    }

    /// Asserts that a condition is false.
    func assert_false(name: str, condition: b8): none
    {
        test::report(name, !condition);
    }

    /// Asserts equality between two 32-bit integers.
    func assert_eq_i32(name: str, actual: i32, expected: i32): none
    {
        if (actual == expected)
        {
            var line: Text = $"[PASS] {name}";
            line.print_line();
        }
        else
        {
            var line: Text = $"[FAIL] {name} (expected {expected}, got {actual})";
            line.print_line();
        }
    }

    /// Asserts equality between two 64-bit integers.
    func assert_eq_i64(name: str, actual: i64, expected: i64): none
    {
        if (actual == expected)
        {
            var line: Text = $"[PASS] {name}";
            line.print_line();
        }
        else
        {
            var line: Text = $"[FAIL] {name} (expected {expected}, got {actual})";
            line.print_line();
        }
    }

    /// Asserts approximate equality between two doubles (epsilon = 0.0001).
    func assert_eq_f64(name: str, actual: f64, expected: f64): none
    {
        var diff: f64 = actual - expected;
        if (diff < 0.0)
        {
            diff = 0.0 - diff;
        }

        if (diff < 0.0001)
        {
            var line: Text = $"[PASS] {name}";
            line.print_line();
        }
        else
        {
            var line: Text = $"[FAIL] {name} (expected {expected:6f}, got {actual:6f})";
            line.print_line();
        }
    }

    /// Asserts equality between two strings.
    func assert_eq_str(name: str, actual: str, expected: str): none
    {
        // The legacy str contract requires valid terminated strings; strcmp does not retain them.
        unsafe
        {
            if (libc_string::strcmp(actual, expected) == 0)
            {
                var line: Text = $"[PASS] {name}";
                line.print_line();
            }
            else
            {
                var line: Text = $"[FAIL] {name} (expected '{expected}', got '{actual}')";
                line.print_line();
            }
        }
    }
}
