/// Sage Savings Calculator
/// A small, useful program that projects compound-interest growth of a savings
/// account year by year. Showcases safe heap references (new/delete), structs,
/// floating-point math, loops, and formatted string interpolation.
use console;

struct Account
{
    name: str;
    principal: f64;
    rate: f64;     // annual interest rate, e.g. 0.07 = 7%
    years: i32;
}

func main(): none
{
    console::print_line("===== Sage Savings Calculator =====");

    // Heap-allocated, memory-safe account reference.
    var acc: Account = new Account {
        name = "Retirement Fund",
        principal = 1000.00,
        rate = 0.07,
        years = 10
    };

    console::print_line("Account:    {acc.name}");
    console::print_line("Principal:  ${acc.principal:2f}");
    console::print_line("Rate:       {acc.rate:2f} per year");
    console::print_line("Horizon:    {acc.years} years");
    console::print_line("-----------------------------------");

    var balance: f64 = acc.principal;
    var interest_total: f64 = 0.0;

    for (var year: i32 = 1; year <= acc.years; year++)
    {
        var interest: f64 = balance * acc.rate;
        balance = balance + interest;
        interest_total = interest_total + interest;

        console::print_line("Year {year}: ${balance:2f}  (+${interest:2f})");
    }

    var growth: f64 = ((balance - acc.principal) / acc.principal) * 100.0;

    console::print_line("-----------------------------------");
    console::print_line("Final balance:  ${balance:2f}");
    console::print_line("Total interest: ${interest_total:2f}");
    console::print_line("Total growth:   {growth:2f}%");

    delete acc;
}
