/// Sage Savings Calculator
/// Projects compound-interest growth of a savings account year by year, keeps the
/// yearly balances in an owned vector, and saves a text report to disk.
/// Everything here is safe Sage: owned values (Text, IntVector, ByteFile) are
/// cleaned up automatically and every fallible operation reports an outcome.
use console;
use text;
use int_vector;
use byte_file;

struct Account
{
    principal: f64;
    rate: f64;     // annual interest rate, e.g. 0.07 = 7%
    years: i32;
}

/// Appends one report line; returns false when the report is full.
func add_line(report: &mut Text, line: &Text): b8
{
    return report.append(&line) && report.append_str("\n");
}

/// Largest year-over-year gain, in cents, from the recorded balances.
func best_gain(balances: &IntVector): i32
{
    var best: i32 = 0;
    var year: u32 = 1;
    while (year < balances.length())
    {
        var previous: IntRead = balances.get(year - 1);
        var current: IntRead = balances.get(year);
        var gain: i32 = current.value - previous.value;
        if (gain > best) { best = gain; }
        year = year + 1;
    }
    return best;
}

func main(): none
{
    var name: Text = text::from("Retirement Fund");
    var acc: Account = { principal = 1000.00, rate = 0.07, years = 10 };

    var title: Text = text::create(64);
    title.append_str("===== ");
    title.append(&name);
    title.append_str(" =====");
    title.print_line();
    var line1: Text = $"Principal:  ${acc.principal:2f}";
    line1.print_line();
    var line2: Text = $"Rate:       {acc.rate:2f} per year";
    line2.print_line();
    var line3: Text = $"Horizon:    {acc.years} years";
    line3.print_line();

    // Balance per year in cents, bounded to the horizon plus the opening balance.
    var balances: IntVector = int_vector::create(acc.years as u32 + 1);
    var balance: f64 = acc.principal;
    balances.push((balance * 100.0) as i32);

    var report: Text = text::create(1024);
    var header: Text = text::from("year,balance");
    add_line(&mut report, &header);
    for (var year: i32 = 1; year <= acc.years; year++)
    {
        balance = balance + balance * acc.rate;
        var grow: VectorGrow = balances.push((balance * 100.0) as i32);
        if (!grow.ok) { var line8: Text = $"Could not record year {year}."; line8.print_line(); }
        var line4: Text = $"Year {year}: ${balance:2f}";
        line4.print_line();
        var row: Text = $"{year},{balance:2f}";
        add_line(&mut report, &row);
    }

    var growth: f64 = ((balance - acc.principal) / acc.principal) * 100.0;
    var gain: i32 = best_gain(&balances);
    var line5: Text = $"Final balance:  ${balance:2f}";
    line5.print_line();
    var line6: Text = $"Total growth:   {growth:2f}%";
    line6.print_line();
    var line7: Text = $"Best year gain: {gain} cents";
    line7.print_line();

    var path: Text = text::from("savings_report.csv");
    var file: ByteFile = byte_file::create_text(&path);
    var saved: ByteTransfer = byte_file::write_text(&mut file, &report);
    if (byte_file::close(file) && !saved.failed)
    {
        console::print("Report saved to ");
        path.print_line();
    }
    else { console::print_line("Report could not be saved."); }
}
